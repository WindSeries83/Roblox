{
  "name": "rift-beasts",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "ServerScriptService": { "$path": "src/server/Main.server.luau" },
      "Bootstrap": { "$path": "src/server/Bootstrap.luau" },
      "Services": { "$path": "src/server/Services" },
      "ServerPackages": { "$path": "ServerPackages" },
      "UnitTestRunner": { "$path": "src/tests/UnitTestRunner.server.luau", "$properties": { "Disabled": true } }
    },
    "ServerStorage": { "UnitTest": { "$path": "src/tests/unit" }, "Tools": { "$path": "src/tools" } },
    "ReplicatedStorage": { "Shared": { "$path": "src/shared" }, "Remotes": { "$className": "Folder" } },
    "StarterPlayer": { "StarterPlayerScripts": { "$path": "src/client" } },
    "StarterGui": { "UiLoader": { "$path": "src/client/UiLoader.client.luau" } },
    "Workspace": {
      "$properties": { "FilteringEnabled": true },
      "SpawnLocation": { "$className": "SpawnLocation", "$properties": { "Anchored": true, "Neutral": true, "Position": [0, 8.7, 0], "Size": [16, 1, 16] } }
    },
    "Lighting": { "$properties": { "Ambient": [0, 0, 0], "Brightness": 2, "GlobalShadows": true, "Outlines": false, "Technology": "Voxel" } },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
