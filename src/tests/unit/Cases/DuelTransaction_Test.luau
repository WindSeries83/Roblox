return function(t)
	local expect = t.expect
	local DuelTransaction = require(game.ReplicatedStorage.Shared.DuelTransaction)

	t.test("follows the durable settlement state machine and is idempotent", function()
		local record = DuelTransaction.New({ Id = "c1", ExpiresAt = 100 })
		expect.truthy(DuelTransaction.Transition(record, "Created", "ChallengerEscrowed"))
		expect.truthy(DuelTransaction.Transition(record, "ChallengerEscrowed", "Accepted"))
		expect.truthy(DuelTransaction.Transition(record, "Accepted", "Resolved", { WinnerUserId = 10 }))
		expect.truthy(DuelTransaction.Transition(record, "Resolved", "WinnerApplied"))
		expect.truthy(DuelTransaction.Transition(record, "WinnerApplied", "LoserApplied"))
		expect.truthy(DuelTransaction.Transition(record, "LoserApplied", "Settled"))
		expect.truthy(DuelTransaction.Transition(record, "LoserApplied", "Settled"))
		expect.truthy(DuelTransaction.IsTerminal(record))
	end)

	t.test("rejects skips and makes duplicate competing accepts a no-op", function()
		local record = DuelTransaction.New({ Id = "c2", ExpiresAt = 100 })
		expect.falsy(DuelTransaction.Transition(record, "Created", "Accepted"))
		expect.truthy(DuelTransaction.Transition(record, "Created", "ChallengerEscrowed"))
		expect.truthy(DuelTransaction.Transition(record, "ChallengerEscrowed", "Accepted"))
		expect.truthy(DuelTransaction.Transition(record, "ChallengerEscrowed", "Accepted", { TargetUserId = 10 }))
		expect.equal(record.TargetUserId, nil)
	end)

	t.test("timeout and refund have their own durable path", function()
		local record = DuelTransaction.New({ Id = "c3", ExpiresAt = 10 })
		expect.truthy(DuelTransaction.Transition(record, "Created", "ChallengerEscrowed"))
		expect.truthy(DuelTransaction.CanExpire(record, 11))
		expect.truthy(DuelTransaction.Transition(record, "ChallengerEscrowed", "TimedOut"))
		expect.truthy(DuelTransaction.Transition(record, "TimedOut", "RefundApplied"))
		expect.truthy(DuelTransaction.Transition(record, "RefundApplied", "Settled"))
	end)
end
