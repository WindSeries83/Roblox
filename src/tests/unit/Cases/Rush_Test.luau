return function(t)
	local expect = t.expect
	local Rush = require(game.ReplicatedStorage.Shared.Rush)

	t.test("completes within target and claims once", function()
		local state = Rush.Start("TwilightGrove", 100, "attempt-1")
		expect.truthy(state)
		expect.equal(state.EndsAt, 280)
		local reward, reason = Rush.Complete("TwilightGrove", state, 280)
		expect.truthy(reward)
		expect.equal(reason, nil)
		expect.equal(reward.Essence, 750)
		expect.truthy(Rush.Claim(state))
		expect.falsy(Rush.Claim(state))
		local replay, replayReason = Rush.Complete("TwilightGrove", state, 280)
		expect.equal(replay, nil)
		expect.equal(replayReason, "already_claimed")
	end)

	t.test("uses server-time boundary and rejects timeout and unknown worlds", function()
		local state = Rush.Start("TwilightGrove", 100)
		local reward, reason = Rush.Complete("TwilightGrove", state, 281)
		expect.equal(reward, nil)
		expect.equal(reason, "timeout")
		expect.equal(Rush.Start("Unknown", 100), nil)
		expect.falsy(Rush.Expire(state, 280))
		expect.truthy(Rush.Expire(state, 281))
		expect.equal(Rush.Status(state, 281), "Expired")
	end)

	t.test("requires an accessible world and preserves reconnectable state", function()
		local locked, reason = Rush.CanStart("AshForge", {}, 0, nil)
		expect.falsy(locked)
		expect.equal(reason, "world_locked")
		local state = Rush.Start("TwilightGrove", 100, "reconnect-1")
		local snapshot = Rush.Snapshot(state, 150)
		expect.truthy(snapshot.Active)
		expect.equal(snapshot.RemainingSeconds, 130)
		expect.equal(snapshot.NextAction, "Wait")
		local canRestart, restartReason = Rush.CanStart("TwilightGrove", {}, 0, state)
		expect.falsy(canRestart)
		expect.equal(restartReason, "active")
		local completed = Rush.Complete("TwilightGrove", state, 200)
		expect.truthy(completed)
		local canClaimRestart, claimReason = Rush.CanStart("TwilightGrove", {}, 0, state)
		expect.falsy(canClaimRestart)
		expect.equal(claimReason, "claim_required")
		expect.equal(Rush.Snapshot(state, 200).NextAction, "Claim")
	end)
end
